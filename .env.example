# Fezer Plus promo -- copy to .env and fill in. .env is gitignored.

# Where the code pool and the claim ledger live: the Supabase Postgres database
# for the "Fezer Website" project. Use the *transaction pooler* (port 6543), not
# a direct connection -- serverless functions open and drop connections
# constantly and the pooler is what makes that survivable.
#
# Supabase dashboard -> Connect -> Transaction pooler. It looks like:
#   postgresql://postgres.<project-ref>:<db-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Tables are created on first use, in their own `promo` schema so that nothing
# here is reachable through the public PostgREST API.
DATABASE_URL=

# Resend. Leave RESEND_API_KEY empty and every "sent" email is written to
# .data/outbox/ instead, so the whole flow can be tested without mailing anyone.
# Set PROMO_EMAIL_TRANSPORT=resend to force real delivery, =console to force the
# dry run.
RESEND_API_KEY=
PROMO_EMAIL_TRANSPORT=
# Must be an address on a domain verified in Resend. Google Workspace hosts the
# fezer.app inbox; Resend sends on the same domain through its own DKIM/SPF
# records, which is why the promo mail and Workspace mail can share fezer.app.
PROMO_EMAIL_FROM=Fezer <hello@fezer.app>
PROMO_EMAIL_REPLY_TO=hello@fezer.app

# Opens /promo-admin and the /api/admin/* endpoints. Generate one with
# `openssl rand -base64 32`. No token set means the admin API is off entirely.
PROMO_ADMIN_TOKEN=

# Absolute origin used to build the tracked redeem links inside emails.
# Locally this can stay empty (the request origin is used).
PROMO_SITE_URL=

# Salt for hashing claimant IPs. Any long random string; changing it resets the
# per-IP rate limit windows.
PROMO_IP_SALT=

# Claims allowed per IP per hour.
PROMO_IP_HOURLY_LIMIT=6

# --- Feature Arena -----------------------------------------------------------

# Optional. A Netlify build hook URL (Site settings -> Build & deploy -> Build
# hooks). The published battles are baked into every prerendered page, so a
# battle published, closed or deleted from /admin is invisible to crawlers and
# link previews until the next deploy -- setting this fires one automatically.
# Leave empty in development.
NETLIFY_BUILD_HOOK=

# Votes one IP may cast in a single battle. Not 1: a household, an office and a
# mobile carrier all share an address. The per-browser token is the real check.
ARENA_IP_VOTES_PER_BATTLE=3

# Votes allowed per IP per hour, across all battles.
ARENA_IP_HOURLY_LIMIT=30

# Autonomous Arena league (all optional, configured in Netlify environment)
ARENA_SUBMISSIONS_PER_IP_HOUR=5
ARENA_MIN_VOTES=10
ARENA_ROUND_DAYS=7
# OpenAI-compatible HTTPS chat-completions URL, model, and API key.
ARENA_AI_ENDPOINT=
ARENA_AI_MODEL=
ARENA_AI_KEY=
# Optional: generate AI contestants when approved queue runs low.
ARENA_AI_SEED=false
# Optional: create GitHub implementation issues for community winners.
ARENA_GITHUB_REPO=yaroshev/fezer.app
ARENA_GITHUB_TOKEN=
